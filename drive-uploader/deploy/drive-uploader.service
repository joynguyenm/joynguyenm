# /etc/systemd/system/drive-uploader.service  (cách chạy không dùng Docker)
[Unit]
Description=drive-uploader (URL -> Google Drive)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=driveup
Group=driveup
WorkingDirectory=/opt/drive-uploader
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
# xvfb-run tạo màn hình ảo để Chromium chạy có giao diện (Cloudflare hay chặn headless)
ExecStart=/usr/bin/xvfb-run -a --server-args="-screen 0 1280x800x24 -nolisten tcp" /usr/bin/node src/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
