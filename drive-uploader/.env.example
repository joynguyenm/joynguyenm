# ===== Cách 1: OAuth2 (khuyên dùng cho Google Drive cá nhân) =====
# Tạo OAuth Client ID loại "Desktop app" trên Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chạy `npm run auth` để lấy refresh token rồi dán vào đây
GOOGLE_REFRESH_TOKEN=

# ===== Cách 2: Service Account (dùng với Shared Drive / thư mục đã share cho SA) =====
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ID thư mục Drive mặc định (lấy từ URL: drive.google.com/drive/folders/<ID>)
DRIVE_FOLDER_ID=

# Cấu hình server
PORT=3000
# Nếu đặt, mọi request tới API phải gửi header: Authorization: Bearer <API_KEY>
API_KEY=
# Địa chỉ lắng nghe (đặt 127.0.0.1 khi đứng sau Nginx)
HOST=0.0.0.0

# ===== Cloudflare / trình duyệt =====
# auto   : thử tải thường trước, gặp Cloudflare thì mở bằng Chromium (mặc định)
# always : luôn tải bằng Chromium
# never  : không bao giờ dùng Chromium
BROWSER_MODE=auto
# Thời gian tối đa chờ qua xác thực Cloudflare (ms). Tăng lên nếu bạn cần bấm tay qua noVNC.
CF_TIMEOUT_MS=120000
# Số job dùng trình duyệt chạy cùng lúc (mỗi job tốn ~200-400MB RAM)
MAX_BROWSER_JOBS=2
# Tắt Chromium sau bao lâu không dùng (ms) để tiết kiệm RAM
BROWSER_IDLE_CLOSE_MS=300000
# Nơi lưu profile Chromium (giữ cookie Cloudflare) và file tạm
BROWSER_PROFILE_DIR=./data/browser-profile
# DOWNLOAD_TMP_DIR=/tmp
# Chỉ đặt nếu muốn ép chế độ headless (true/false). Mặc định: có DISPLAY thì chạy có giao diện.
# BROWSER_HEADLESS=

# ===== noVNC (chỉ khi chạy bằng Docker) =====
# Bật để xem trình duyệt từ xa và bấm tay khi Cloudflare hiện ô "Verify you are human"
ENABLE_VNC=false
VNC_PASSWORD=
